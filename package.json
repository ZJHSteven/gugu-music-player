{
  "name": "obr-bard",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Owlbear Rodeo 房间音乐插件：GM 播放本地音乐 / B 站音频，全房间同步收听",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server/index.js",
    "build:cloud": "node tools/build-cloud.mjs",
    "test:cloud": "node --test tests/cloud/*.test.mjs",
    "verify:cloud": "node tools/check-cloud-extension.mjs",
    "verify:cloud:online": "node tools/check-cloud-extension.mjs --online",
    "deploy:cloud": "npm run build:cloud && wrangler deploy",
    "vendor": "node tools/vendor-sdk.mjs",
    "selftest": "node tools/selftest.mjs",
    "uitest": "node tools/uitest.mjs",
    "check-release": "node tools/check-release.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.164.0"
  }
}
